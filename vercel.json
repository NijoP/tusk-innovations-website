{
  "installCommand": "npm install --legacy-peer-deps",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tuskinnovations.in"
        }
      ],
      "destination": "https://www.tuskinnovations.in/:path*",
      "permanent": true
    }
  ]
}
